msgid "No validation"
msgstr "சரிபார்ப்பு இல்லை"

msgid "Required (not empty)"
msgstr "தேவை (காலியாக இருக்கக்கூடாது)"

msgid "Whole number"
msgstr "முழு எண்"

msgid "Number (decimal)"
msgstr "எண் (தசம)"

msgid "Email"
msgstr "மின்னஞ்சல்"

msgid "Phone"
msgstr "தொலைபேசி"

msgid "URL"
msgstr "URL"

msgid "Date"
msgstr "தேதி"

msgid "Letters only"
msgstr "எழுத்துகள் மட்டும்"

msgid "Letters & numbers"
msgstr "எழுத்துகள் & எண்கள்"

msgid "Custom (regex)"
msgstr "தனிப்பயன் (regex)"

msgid "This field is required."
msgstr "இந்த புலம் தேவை."

msgid "Please enter a whole number."
msgstr "தயவுசெய்து ஒரு முழு எண்ணை உள்ளிடவும்."

msgid "Please enter a valid number."
msgstr "தயவுசெய்து சரியான எண்ணை உள்ளிடவும்."

msgid "Please enter a valid email address."
msgstr "தயவுசெய்து சரியான மின்னஞ்சல் முகவரியை உள்ளிடவும்."

msgid "Please enter a valid phone number."
msgstr "தயவுசெய்து சரியான தொலைபேசி எண்ணை உள்ளிடவும்."

msgid "Please enter a valid URL."
msgstr "தயவுசெய்து சரியான URL ஐ உள்ளிடவும்."

msgid "Please enter a valid date."
msgstr "தயவுசெய்து சரியான தேதியை உள்ளிடவும்."

msgid "Please use letters only."
msgstr "தயவுசெய்து எழுத்துகளை மட்டும் பயன்படுத்தவும்."

msgid "Please use letters and numbers only."
msgstr "தயவுசெய்து எழுத்துகள் மற்றும் எண்களை மட்டும் பயன்படுத்தவும்."

msgid "The value does not match the required format."
msgstr "மதிப்பு தேவையான வடிவமைப்புடன் பொருந்தவில்லை."

msgid "Invalid value."
msgstr "தவறான மதிப்பு."

msgid "Tour saved!"
msgstr "சுற்றுப்பயணம் சேமிக்கப்பட்டது!"

msgid "Tour updated!"
msgstr "சுற்றுப்பயணம் புதுப்பிக்கப்பட்டது!"

msgid "Tour deleted."
msgstr "சுற்றுப்பயணம் நீக்கப்பட்டது."

msgid "Steps saved."
msgstr "படிகள் சேமிக்கப்பட்டன."

msgid "Recording cancelled."
msgstr "பதிவு ரத்து செய்யப்பட்டது."

msgid "No steps were recorded yet."
msgstr "இன்னும் படிகள் பதிவு செய்யப்படவில்லை."

msgid "Please give your tour a name."
msgstr "தயவுசெய்து உங்கள் சுற்றுப்பயணத்திற்கு ஒரு பெயரிடவும்."

msgid "Every step needs a CSS trigger selector."
msgstr "ஒவ்வொரு படிக்கும் ஒரு CSS தூண்டுதல் தேர்வி தேவை."

msgid "Delete Tour"
msgstr "சுற்றுப்பயணத்தை நீக்கு"

msgid "Delete"
msgstr "நீக்கு"

msgid "Please select a file to import."
msgstr "இறக்குமதி செய்ய ஒரு கோப்பைத் தேர்ந்தெடுக்கவும்."

msgid "The file does not contain any tours."
msgstr "கோப்பில் எந்த சுற்றுப்பயணமும் இல்லை."

msgid "Imported Tour"
msgstr "இறக்குமதி செய்யப்பட்ட சுற்றுப்பயணம்"

msgid "Import complete"
msgstr "இறக்குமதி முடிந்தது"

msgid "Imported Tours"
msgstr "இறக்குமதி செய்யப்பட்ட சுற்றுப்பயணங்கள்"
