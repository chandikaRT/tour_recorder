# Target Odoo instance for Playwright runs (copy to `.env` and fill in).
# Use a STAGING / disposable database — the specs perform real clicks and
# may create real records on whatever DB they run against.

# Full origin of the Odoo instance, no trailing slash.
ODOO_URL=https://your-staging.odoo.sh.example.com

# Database name. Leave blank if the instance auto-selects a single DB.
ODOO_DB=

# Login credentials used by auth.setup.mjs to establish a session.
ODOO_LOGIN=admin
ODOO_PASSWORD=change-me
