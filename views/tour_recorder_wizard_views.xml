<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================== EXPORT WIZARD ===================== -->
    <record id="view_tour_export_wizard_form" model="ir.ui.view">
        <field name="name">tour.recorder.export.wizard.form</field>
        <field name="model">tour.recorder.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Tours">
                <div class="alert alert-success" role="alert">
                    Your export is ready — click the file below to download it.
                    One tour downloads as a single <b>.json</b>; several download as a
                    <b>.zip</b> containing one <b>.json</b> per tour.
                </div>
                <group>
                    <field name="filename" invisible="1"/>
                    <field name="data" filename="filename" readonly="1"/>
                </group>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Export server action, shown in the Action menu of the tours list/form -->
    <record id="action_export_tours_server" model="ir.actions.server">
        <field name="name">Export Tours</field>
        <field name="model_id" ref="model_tour_recorder"/>
        <field name="binding_model_id" ref="model_tour_recorder"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('group_tour_manager'))]"/>
        <field name="state">code</field>
        <field name="code">
action = records._export_download()
        </field>
    </record>

    <!-- Export ALL tours (bulk) — menu action, no selection needed -->
    <record id="action_export_all_tours_server" model="ir.actions.server">
        <field name="name">Export All Tours</field>
        <field name="model_id" ref="model_tour_recorder"/>
        <field name="state">code</field>
        <field name="code">
action = env['tour.recorder'].search([])._export_download()
        </field>
    </record>

    <menuitem id="menu_tour_export_all"
              name="Export All Tours"
              parent="menu_tour_recorder_root"
              action="action_export_all_tours_server"
              groups="group_tour_manager"
              sequence="15"/>

    <!-- ===================== IMPORT WIZARD ===================== -->
    <record id="view_tour_import_wizard_form" model="ir.ui.view">
        <field name="name">tour.recorder.import.wizard.form</field>
        <field name="model">tour.recorder.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Tours">
                <div class="text-muted mb-2">
                    Upload a <b>.json</b> file previously exported from a Tour Recorder
                    (it may contain many tours), or a <b>.zip</b> of several such
                    <b>.json</b> files to import them all at once.
                </div>
                <group>
                    <field name="data" filename="filename" required="1"/>
                    <field name="filename" invisible="1"/>
                </group>
                <footer>
                    <button string="Import" name="action_import" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_tour_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Tours</field>
        <field name="res_model">tour.recorder.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_tour_import"
              name="Import Tours"
              parent="menu_tour_recorder_root"
              action="action_tour_import_wizard"
              groups="group_tour_manager"
              sequence="20"/>

</odoo>
