<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="custom_tour_recorder.GuidesSystray">
        <div class="o_tour_recorder_systray">
            <div class="position-relative d-inline-flex">
                <button class="btn o_tr_guides_btn d-flex align-items-center"
                        t-on-click="onClick" title="View your assigned guides">
                    <i class="fa fa-lightbulb-o me-1"/>
                    <span>Guides</span>
                </button>
                <span t-if="state.incompleteCount > 0"
                      class="o_tr_incomplete_badge"
                      t-esc="state.incompleteCount"/>
            </div>
        </div>
    </t>

</templates>
